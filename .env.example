# ==================================================
# MEDIAFLOW PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# ==================================================

# --------------------------------------------------
# Next.js Server Configuration (Vercel Environment)
# --------------------------------------------------
# Server-side URL of long-running Express Media Worker service (MUST NOT be exposed to browser)
MEDIA_WORKER_URL=https://worker.yourdomain.com

# Shared authentication secret between Next.js server-side API routes and Media Worker service
MEDIA_WORKER_SECRET=your_production_worker_secret_here

# Optional YouTube Data API v3 key (Server-side metadata lookup)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional Anonymous API Rate Limiting Overrides
RATE_LIMIT_ANALYZE_MAX=20
RATE_LIMIT_DOWNLOAD_MAX=10

# --------------------------------------------------
# Media Worker Container Configuration (Docker / Render / Container)
# --------------------------------------------------
# Worker HTTP Server Host & Port (Required: process.env.PORT / 0.0.0.0 for containers)
HOST=0.0.0.0
PORT=3001
WORKER_HOST=0.0.0.0
WORKER_PORT=3001

# Source Acquisition & Processing Resource Limits
SOURCE_ACQUISITION_TIMEOUT_SECONDS=120
PROCESSING_TIMEOUT_SECONDS=300
MAX_INPUT_MB=500
MAX_OUTPUT_MB=500
TEMP_FILE_TTL_SECONDS=3600

# Custom binary path overrides (Optional, left empty for automatic PATH detection)
YT_DLP_PATH=
FFMPEG_PATH=
