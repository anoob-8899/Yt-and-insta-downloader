# ==================================================
# MEDIAFLOW ENVIRONMENT VARIABLES (.env.example)
# ==================================================

# Media Processing Worker Endpoint (Deployed separately on long-running container)
MEDIA_WORKER_URL=https://worker.mediaflow.internal/api/v1
MEDIA_WORKER_SECRET=your_worker_shared_secret_here

# Temporary Storage Configuration (S3 / R2 / MinIO compatible)
MEDIA_STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
MEDIA_STORAGE_BUCKET=mediaflow-temp-processing
MEDIA_STORAGE_ACCESS_KEY=placeholder_access_key
MEDIA_STORAGE_SECRET_KEY=placeholder_secret_key

# Optional Rate Limiting Overrides
RATE_LIMIT_ANALYZE_MAX=20
RATE_LIMIT_DOWNLOAD_MAX=10
